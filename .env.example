# ---------------------------------------------------------------------------
# Atlas environment configuration
#
# Copy to `.env.local` before running or deploying. In production these are baked into the build by
# `npm run deploy`, which reads this file. See README step 4.
#
# IMPORTANT: everything prefixed with VITE_ is inlined into the client bundle
# and is therefore PUBLIC. That is fine and expected for Firebase web config —
# these are project identifiers, not credentials. All real access control lives
# in Firestore Security Rules, and all confidentiality lives in the
# client-side AES-256-GCM layer. Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Identifier for the single conversation. Any opaque string; it appears in
# Firestore paths but never in the UI. Use something unguessable.
VITE_ROOM_ID=

# Optional. Enables the GIF search panel. Get a free key at
# developers.giphy.com -> Create an App -> API (not SDK).
#
# PRIVACY: with this set, search terms you type in the GIF panel are sent to
# Giphy. The GIF you choose is downloaded, encrypted, and stored in Firestore
# like any other image, so the recipient never contacts Giphy. Leave this blank
# and the GIF button is hidden entirely.
VITE_GIPHY_API_KEY=

# Optional: point the SDK at local emulators during development.
VITE_USE_EMULATORS=false
