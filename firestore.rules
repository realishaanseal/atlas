rules_version = '2';

// ---------------------------------------------------------------------------
// Atlas — Firestore Security Rules
//
// Threat model: these rules are the SECOND line of defence. Even a total
// bypass yields only AES-256-GCM ciphertext. Their job is to prevent quota
// exhaustion, spam writes, and casual interference — not to protect
// confidentiality. That is the encryption layer's job, exclusively.
//
// Principles:
//   1. Default deny. Anything not matched below is refused.
//   2. Only a signed-in client occupying one of the room's two device slots
//      may read or write.
//   3. Messages are immutable once written, except `readAt`, which only the
//      non-sender may set, and only once.
//   4. Every write is shape-validated: exact key sets, types, and hard byte
//      caps, so a compromised client cannot inflate storage costs.
//   5. `expiresAt` must equal `createdAt + 24h`. Clients cannot opt out of
//      retention, and expired documents cannot be read.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function now() {
      return request.time.toMillis();
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    // The A side may hold three devices — deviceA plus the optional deviceA2 and
    // deviceA3 — so one person can be on two laptops and a phone at once. get()
    // with a default tolerates rooms created before each field existed, which is
    // what makes adding a slot a non-migration. The B side stays single.
    function isA(roomId) {
      return signedIn()
        && (roomData(roomId).deviceA == uid()
            || roomData(roomId).get('deviceA2', null) == uid()
            || roomData(roomId).get('deviceA3', null) == uid());
    }

    function isB(roomId) {
      return signedIn() && roomData(roomId).deviceB == uid();
    }

    // A single get(), cached for the duration of the request evaluation.
    function isPaired(roomId) {
      return isA(roomId) || isB(roomId);
    }

    // Which slot the caller currently occupies, derived from the room document
    // rather than from anything the caller sends. Returns '' when unpaired,
    // which matches no field name and so grants nothing. Both A devices report
    // 'a'.
    function mySlot(roomId) {
      return isA(roomId) ? 'a' : (isB(roomId) ? 'b' : '');
    }

    // Whether a pin document exists for a given message/media id. Pins are keyed
    // by the message id, so this is what lets a message's expiry be extended
    // ONLY while it is genuinely pinned — the retention guarantee still holds for
    // everything unpinned.
    function pinnedExists(roomId, id) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/pins/$(id));
    }

    // ~Year 3000. Stamped on a pinned message so the sweep skips it. Must match
    // PINS.KEEP_UNTIL in config.ts.
    function pinKeepUntil() {
      return 32503680000000;
    }

    // Base64url only. Rejects padding, whitespace, and anything that could be
    // smuggled into a path or rendered as markup.
    function isB64(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen
        && value.matches('^[A-Za-z0-9_-]+$');
    }

    // { v: 1, iv: <12 bytes b64 = 16 chars>, ct: <ciphertext> }
    function validEnvelope(e, maxCt) {
      return e is map
        && e.keys().hasOnly(['v', 'iv', 'ct'])
        && e.keys().hasAll(['v', 'iv', 'ct'])
        && e.v == 1
        && isB64(e.iv, 24)
        && isB64(e.ct, maxCt);
    }

    // 24h retention, enforced server-side. ±60s tolerance for clock skew.
    function validRetention(data) {
      return data.createdAt is int
        && data.expiresAt is int
        && data.createdAt >= now() - 60000
        && data.createdAt <= now() + 60000
        && data.expiresAt == data.createdAt + 86400000;
    }

    function notExpired(data) {
      return data.expiresAt > now();
    }

    // --- room ------------------------------------------------------------
    //
    // The room document holds the two device slots. Making them fields rather
    // than a collection means the "exactly two devices" cap is structural —
    // there is no third field to write.

    match /rooms/{roomId} {

      // Readable by any signed-in client, because a client must read the slots
      // to discover whether it is paired. The document contains no secrets.
      allow get: if signedIn();
      allow list: if false;

      // First device to arrive creates the room and claims slot A. New rooms
      // carry every extra A slot and the link marker from the start; older rooms
      // do not, and the rules below read those via get() so both shapes work.
      //
      // `hasOnly` is an exact whitelist, so this list has to be kept in step
      // with what createRoom() actually writes. It was not, when deviceA3 was
      // added: the client started writing a field the rule did not permit, which
      // would have rejected room creation outright. Nothing noticed because the
      // room already existed — it would only have surfaced during a rebuild,
      // which is the worst possible moment to discover it.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['schemaVersion', 'createdAt', 'deviceA', 'deviceA2', 'deviceA3',
              'deviceB', 'repairUntil', 'linkTarget'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt >= now() - 60000
        && request.resource.data.deviceA == uid()
        && request.resource.data.get('deviceA2', null) == null
        && request.resource.data.get('deviceA3', null) == null
        && request.resource.data.deviceB == null
        && request.resource.data.repairUntil == 0
        && request.resource.data.linkTarget == null;

      // Slot transitions for the A side. An A slot may be:
      //   - left unchanged
      //   - claimed, if currently empty
      //   - released, by its own occupant
      //   - taken over, but only during a re-pair window that an already-paired
      //     device opened (see repairUntil below)
      function slotOk(oldSlot, newSlot) {
        return newSlot == oldSlot
          || (oldSlot == null && newSlot == uid())
          || (oldSlot == uid() && newSlot == null)
          || (resource.data.repairUntil > now() && newSlot == uid());
      }

      /**
       * Slot B is deliberately open: any signed-in device may take it at any
       * time, even while occupied.
       *
       * The reason is practical. The B device browses in private mode, so its
       * anonymous uid is discarded every session and the slot would otherwise
       * stay locked to a uid that no longer exists anywhere, with nobody able to
       * release it.
       *
       * What this costs, stated plainly rather than buried: these rules cannot
       * check passphrase knowledge — they see an authenticated anonymous uid and
       * nothing else — so "anyone who knows the passphrase" is in practice
       * "anyone at all". Somebody who found the site, dug the room id out of the
       * bundle and drove the SDK directly could seize this slot, evict the B
       * device, and write junk that appears to come from it.
       *
       * What it does NOT cost: they still cannot read anything. Every payload is
       * AES-256-GCM and the key is derived from the passphrase on-device and
       * never transmitted, so an occupied slot buys ciphertext and nothing else.
       *
       * The unlock throttle does not protect this. It is client-side, so it only
       * ever slows down someone typing guesses into our own UI.
       */
      function slotBOk(newSlot) {
        return newSlot == resource.data.deviceB
          || newSlot == uid()
          || (resource.data.deviceB == uid() && newSlot == null);
      }

      // No uid may occupy two DIFFERENT slots. Several A devices are the point,
      // so the A slots differing from each other is required — but no A slot may
      // equal deviceB, or one device would be both sides of the conversation and
      // could stamp its own read receipts.
      //
      // Written out in full rather than looped because Security Rules have no
      // loops, and every pair genuinely has to be checked.
      function distinctSlots(d) {
        return (d.deviceA == null || d.deviceA != d.deviceB)
          && (d.get('deviceA2', null) == null || d.get('deviceA2', null) != d.deviceB)
          && (d.get('deviceA3', null) == null || d.get('deviceA3', null) != d.deviceB)
          && (d.get('deviceA2', null) == null || d.deviceA == null
              || d.get('deviceA2', null) != d.deviceA)
          && (d.get('deviceA3', null) == null || d.deviceA == null
              || d.get('deviceA3', null) != d.deviceA)
          && (d.get('deviceA3', null) == null || d.get('deviceA2', null) == null
              || d.get('deviceA3', null) != d.get('deviceA2', null));
      }

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deviceA', 'deviceA2', 'deviceA3', 'deviceB', 'repairUntil', 'linkTarget'])
        && slotOk(resource.data.deviceA, request.resource.data.deviceA)
        && slotOk(resource.data.get('deviceA2', null),
                  request.resource.data.get('deviceA2', null))
        && slotOk(resource.data.get('deviceA3', null),
                  request.resource.data.get('deviceA3', null))
        && slotBOk(request.resource.data.deviceB)
        && distinctSlots(request.resource.data)
        // Only an already-paired device may open a re-pair window, and it may
        // open it for at most 5 minutes.
        && (request.resource.data.repairUntil == resource.data.repairUntil
            || (isPaired(roomId)
                && request.resource.data.repairUntil <= now() + 300000))
        // linkTarget may only be cleared, or set to 'a' by a paired device.
        && (request.resource.data.get('linkTarget', null) == resource.data.get('linkTarget', null)
            || request.resource.data.get('linkTarget', null) == null
            || (isPaired(roomId) && request.resource.data.get('linkTarget', null) == 'a'));

      // Recovering from losing both devices is a console operation, on
      // purpose. There is no client-side path to wiping the pairing state.
      allow delete: if false;

      // --- kdf params ----------------------------------------------------
      //
      // The PBKDF2 salt and the key verifier. Public, non-secret, and written
      // exactly once when the room is first set up. Immutable thereafter:
      // changing the salt would orphan every existing message.

      match /meta/kdf {
        allow get: if signedIn();

        allow create: if isPaired(roomId)
          && request.resource.data.keys().hasOnly(
               ['v', 'algorithm', 'hash', 'iterations', 'salt', 'verifier', 'createdAt'])
          && request.resource.data.v == 1
          && request.resource.data.algorithm == 'PBKDF2'
          && request.resource.data.hash == 'SHA-256'
          && request.resource.data.iterations >= 600000
          && request.resource.data.iterations <= 5000000
          && isB64(request.resource.data.salt, 32)
          && validEnvelope(request.resource.data.verifier, 128)
          && request.resource.data.createdAt >= now() - 60000;

        allow update, delete: if false;
      }

      match /meta/{other} {
        allow read, write: if false;
      }

      // --- presence ------------------------------------------------------
      //
      // Heartbeat + typing. Each client owns exactly one slot document and
      // may only write its own. Deliberately coarse: no per-keystroke data.

      match /presence/{slot} {
        allow get, list: if isPaired(roomId) && (slot == 'a' || slot == 'b');

        // Write access is tied to whoever currently holds that slot in the
        // ROOM document — not to whoever wrote the presence document first.
        //
        // The earlier version pinned ownership to the existing presence doc's
        // `owner` field, which meant a device that legitimately took over a
        // slot (after a re-pair, or after the room doc was edited) could never
        // write presence again. Its heartbeats were rejected forever, and
        // because presence errors are deliberately swallowed, the only symptom
        // was "last seen" freezing at a stale time.
        //
        // Deriving permission from the room document instead makes this
        // self-healing: claim the slot, and presence starts working.
        allow create, update: if isPaired(roomId)
          && request.resource.data.keys().hasOnly(
               ['owner', 'online', 'lastSeen', 'typingUntil'])
          && request.resource.data.owner == uid()
          && ((slot == 'a' && isA(roomId)) || (slot == 'b' && isB(roomId)))
          && request.resource.data.online is bool
          && request.resource.data.lastSeen >= now() - 60000
          && request.resource.data.lastSeen <= now() + 60000
          // Typing indicator is self-expiring and capped, so a buggy or
          // malicious client cannot pin it on indefinitely.
          && request.resource.data.typingUntil is int
          && request.resource.data.typingUntil <= now() + 15000;

        allow delete: if false;
      }

      // --- messages ------------------------------------------------------

      match /messages/{messageId} {

        // Direct reads refuse expired documents outright.
        allow get: if isPaired(roomId) && notExpired(resource.data);

        // Queries deliberately do NOT check expiry, and the reason matters.
        //
        // A live listener's range filter is fixed at subscription time, so a
        // document that expires while the listener is open still matches the
        // query. If the rule then rejected it, Firestore would tear down the
        // whole listener — a tab left open overnight would silently stop
        // receiving messages. Correctness of the live stream wins here.
        //
        // What this concedes: a paired device can list expired-but-not-yet
        // swept documents. That leaks nothing — the same device could read
        // those messages before they expired, and they remain AES-256-GCM
        // ciphertext regardless. Only paired devices can list at all.
        //
        // The client filters expired documents out of the UI, and the sweep
        // below deletes them.
        allow list: if isPaired(roomId);

        // A scheduled message is just a message with a FUTURE createdAt — it
        // sorts into the timeline at its delivery time and the recipient's
        // client hides it until then. That is why the upper bound on createdAt
        // is a week out here rather than the ±1min of `validRetention`, while
        // expiresAt stays exactly 24h past createdAt (so a scheduled message
        // lives 24h after it is delivered, not after it was written).
        allow create: if isPaired(roomId)
          && request.resource.data.keys().hasOnly(
               ['sender', 'createdAt', 'expiresAt', 'body'])
          && request.resource.data.sender in ['a', 'b']
          // The sender field must match the slot this uid actually holds.
          && ((request.resource.data.sender == 'a' && isA(roomId))
              || (request.resource.data.sender == 'b' && isB(roomId)))
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt >= now() - 60000
          && request.resource.data.createdAt <= now() + 604800000
          // Retention is chosen per message, but only DOWNWARD: anything from a
          // minute up to the standard 24 hours. The ceiling is the point — a
          // client cannot opt out of retention or keep a message indefinitely,
          // which was the original guarantee. Shorter is always allowed because
          // it only ever destroys data sooner.
          && request.resource.data.expiresAt > request.resource.data.createdAt
          && request.resource.data.expiresAt <= request.resource.data.createdAt + 86400000
          // ~12 KB ciphertext ceiling. Text is padded to at most 4096 bytes
          // before encryption; image messages carry only a wrapped key and a
          // small blur preview, never the image itself.
          && validEnvelope(request.resource.data.body, 16384);

        // Immutable, except that the recipient may stamp readAt exactly once.
        allow update: if isPaired(roomId)
          && notExpired(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && !('readAt' in resource.data)
          && request.resource.data.readAt >= now() - 60000
          && request.resource.data.readAt <= now() + 60000
          // Only the party who did NOT send it can mark it read.
          && ((resource.data.sender == 'a' && isB(roomId))
              || (resource.data.sender == 'b' && isA(roomId)));

        // Delivery receipt, same shape as readAt: the recipient — and only the
        // recipient — stamps it exactly once, and it cannot be moved afterwards.
        // Kept as its own field rather than inferred from the document existing,
        // because "the server has it" and "their device has it" are genuinely
        // different facts, and the second tick is only meaningful if it means
        // the latter.
        allow update: if isPaired(roomId)
          && notExpired(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt'])
          && !('deliveredAt' in resource.data)
          && request.resource.data.deliveredAt >= now() - 60000
          && request.resource.data.deliveredAt <= now() + 60000
          && ((resource.data.sender == 'a' && isB(roomId))
              || (resource.data.sender == 'b' && isA(roomId)));

        // Reactions — the one place a device may write to a message it did
        // not send.
        //
        // The constraint that makes that safe: each participant owns exactly
        // one key in the `reactions` map, named for their slot, and may touch
        // only that key. Without this, "allow reactions" would be "allow
        // arbitrary edits to your peer's messages" — the sender could rewrite
        // ciphertext under a message the recipient has already read.
        //
        // The value is an encrypted envelope, not a plain emoji. A reaction is
        // content: "reacted 😭 to that message" is exactly what the rest of
        // the app refuses to leak.
        allow update: if isPaired(roomId)
          && notExpired(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {})
               .diff(resource.data.get('reactions', {}))
               .affectedKeys()
               .hasOnly([mySlot(roomId)])
          // Either set to a valid envelope, or removed entirely.
          && (!(mySlot(roomId) in request.resource.data.get('reactions', {}))
              // 2048 base64 chars. Twenty custom-emoji references — the
              // per-person cap in config — encode to roughly 880, so this
              // leaves generous headroom while still bounding the field.
              || validEnvelope(request.resource.data.reactions[mySlot(roomId)], 2048));

        // Editing. Only the SENDER may change the body of their own message,
        // and only `body` / `editedAt` / `originalBody` may move. The original
        // is snapshotted exactly once — on the first edit `originalBody` is
        // added, and every later edit must leave it untouched — so the history
        // always shows the true first version. Reactions and read receipts are
        // deliberately not touchable here; each has its own rule.
        allow update: if isPaired(roomId)
          && notExpired(resource.data)
          && ((resource.data.sender == 'a' && isA(roomId))
              || (resource.data.sender == 'b' && isB(roomId)))
          && request.resource.data.editedAt is int
          && request.resource.data.editedAt >= now() - 60000
          && request.resource.data.editedAt <= now() + 60000
          && validEnvelope(request.resource.data.body, 16384)
          && (
               // First edit: original preserved alongside the new body.
               (!('originalBody' in resource.data)
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['body', 'editedAt', 'originalBody'])
                 && validEnvelope(request.resource.data.originalBody, 16384))
               // Later edit: original already stored, must stay put.
               || (('originalBody' in resource.data)
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['body', 'editedAt']))
             );

        // Pinning keeps a message past the 24h sweep; unpinning restores its
        // normal expiry. Only `expiresAt` may change, and only in agreement with
        // whether a pin document exists for this message — so a message's life
        // can be extended only while it is genuinely pinned. Every other field,
        // including the ciphertext, stays immutable.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is int
          && (
               (pinnedExists(roomId, messageId)
                 && request.resource.data.expiresAt == pinKeepUntil())
               || (!pinnedExists(roomId, messageId)
                 && request.resource.data.expiresAt == resource.data.createdAt + 86400000)
             );

        // Deletes are the retention sweep (only expired documents), OR a sender
        // cancelling their own scheduled message before it is delivered — a
        // message whose createdAt is still in the future has not been shown to
        // the other person yet, so pulling it back leaks nothing.
        allow delete: if isPaired(roomId)
          && (resource.data.expiresAt <= now()
              || (resource.data.createdAt > now()
                  && ((resource.data.sender == 'a' && isA(roomId))
                      || (resource.data.sender == 'b' && isB(roomId)))));
      }

      // --- images ----------------------------------------------------------
      //
      // Encrypted image bytes, one document per image. These live in Firestore
      // rather than Cloud Storage because Storage requires the paid Blaze plan.
      //
      // Firestore caps a document at 1 MiB. The client compresses to ~600 KB
      // before encrypting; the 1,000,000-character ceiling below is the hard
      // backstop that keeps a write from being rejected by the platform (and
      // stops anyone using the collection as free bulk storage).
      //
      // Kept in its own collection rather than inline on the message so that
      // subscribing to the message list does not drag ~800 KB of base64 along
      // with every snapshot.

      match /images/{imageId} {

        // Images are always fetched by id, never queried, so the strict
        // expiry check costs nothing here.
        allow get: if isPaired(roomId) && notExpired(resource.data);
        allow list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && imageId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'createdAt', 'expiresAt', 'data'])
          && request.resource.data.owner == uid()
          && validRetention(request.resource.data)
          && validEnvelope(request.resource.data.data, 1000000);

        // The ciphertext stays write-once — only `expiresAt` may change, so a
        // writer still cannot swap the image under an id the peer has accepted.
        // This exists so pinning a message can keep its image past the sweep:
        // the new value is either the far-future pin sentinel (extend) or at
        // most 24h out (restore). The pin link is checked on the message doc,
        // not here — an image document does not know which message references
        // it — so this is a deliberate, value-bounded relaxation.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is int
          && (request.resource.data.expiresAt == pinKeepUntil()
              || request.resource.data.expiresAt <= now() + 86400000);

        allow delete: if isPaired(roomId) && resource.data.expiresAt <= now();
      }

      // --- videos ----------------------------------------------------------
      //
      // Same shape and constraints as images: encrypted bytes, chunked across
      // documents (videos/{id}-c0 …) because one clip far exceeds the 1 MiB
      // document cap, each chunk with its own IV and its own 24h expiry so the
      // sweep collects them without knowing they are chunks. Stored byte-for-byte
      // like GIFs — no server-side transcode — so the per-doc ceiling is the same
      // hard backstop as images.

      match /videos/{videoId} {

        allow get: if isPaired(roomId) && notExpired(resource.data);
        allow list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && videoId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'createdAt', 'expiresAt', 'data'])
          && request.resource.data.owner == uid()
          && validRetention(request.resource.data)
          && validEnvelope(request.resource.data.data, 1000000);

        // Write-once except expiresAt, so a pinned video can outlive the sweep;
        // see the images rule for the full reasoning.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is int
          && (request.resource.data.expiresAt == pinKeepUntil()
              || request.resource.data.expiresAt <= now() + 86400000);

        allow delete: if isPaired(roomId) && resource.data.expiresAt <= now();
      }

      // --- file attachments -------------------------------------------------
      //
      // Same shape as videos: encrypted bytes, chunked across documents, each
      // chunk with its own 24h expiry so the sweep collects them without knowing
      // they are chunks. The filename and MIME live inside the message payload,
      // encrypted — never here, where they would describe the conversation in
      // the clear.

      match /files/{fileId} {

        allow get: if isPaired(roomId) && notExpired(resource.data);
        allow list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && fileId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'createdAt', 'expiresAt', 'data'])
          && request.resource.data.owner == uid()
          && validRetention(request.resource.data)
          && validEnvelope(request.resource.data.data, 1000000);

        // Write-once except expiresAt, so a pinned file can outlive the sweep.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is int
          && (request.resource.data.expiresAt == pinKeepUntil()
              || request.resource.data.expiresAt <= now() + 86400000);

        allow delete: if isPaired(roomId) && resource.data.expiresAt <= now();
      }

      // --- custom emoji ----------------------------------------------------
      //
      // The one collection in this app with NO expiry, and that is the whole
      // point of it. Everything else is swept after 24 hours; an emoji pack
      // that evaporated daily would be useless. So `emojis` documents carry no
      // `expiresAt`, and `validRetention` is deliberately not applied.
      //
      // Shared rather than per-device: both participants see one pack, like a
      // Discord server's. Either may add or remove, which is why delete is not
      // restricted to the owner — a pack only one person can prune is a pack
      // that fills up with the other person's mistakes.
      //
      // The NAME is encrypted, not just the image. `:inside_joke:` is content,
      // and a shortcode list in the clear would be a readable index of what the
      // two of you find funny.
      //
      // Known limitation: rules cannot cheaply count a collection, so the cap
      // on how many emoji exist is enforced client-side only. A modified client
      // could write more. The blast radius is storage quota, not
      // confidentiality, and it is bounded by the same trust as everything else
      // here — only a paired device can write at all, and a paired device
      // already holds the passphrase.

      match /emojis/{emojiId} {

        allow get, list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && emojiId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'createdAt', 'name', 'mime', 'width', 'height', 'data'])
          && request.resource.data.owner == uid()
          && request.resource.data.createdAt >= now() - 60000
          && request.resource.data.createdAt <= now() + 60000
          && request.resource.data.mime in ['image/webp', 'image/gif']
          && request.resource.data.width is int
          && request.resource.data.width > 0
          && request.resource.data.width <= 512
          && request.resource.data.height is int
          && request.resource.data.height > 0
          && request.resource.data.height <= 512
          && validEnvelope(request.resource.data.name, 256)
          // ~256 KB of plaintext, base64-inflated. Comfortably inside the 1 MiB
          // document cap and far more than a 128px emoji needs, with room for
          // an animated one.
          && validEnvelope(request.resource.data.data, 400000);

        // Write-once, like images: an update would let a writer swap the
        // artwork under a shortcode the other person has already seen and
        // started using.
        allow update: if false;

        allow delete: if isPaired(roomId);
      }

      // --- pinned messages -------------------------------------------------
      //
      // Like emoji, these do NOT expire — a pin that vanished with its message
      // after 24 hours would be pointless. So no `expiresAt`, and
      // `validRetention` is deliberately not applied.
      //
      // The document id is the message id. That makes pinning idempotent and
      // unpinning a plain delete, and it satisfies the same id pattern the
      // other collections use, so no special validation is needed.
      //
      // The message itself is swept after 24 hours, so the pin cannot lean on
      // it: the displayable content is snapshotted into `snapshot` (encrypted)
      // at pin time. That snapshot is content — the pinned message's text — so
      // it is encrypted like everything else, never stored in the clear.
      //
      // Either paired device may delete a pin, not only whoever created it. A
      // pin is shared state; a pin only one person could remove would leave the
      // other stuck with it. Same reasoning as emoji.
      //
      // Known limitation: the count cap (see config PINS.MAX_COUNT) is
      // client-side only, because rules cannot cheaply count a collection. The
      // exposure is storage quota, not confidentiality.

      match /pins/{pinId} {

        allow get, list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && pinId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(['owner', 'pinnedAt', 'snapshot'])
          && request.resource.data.owner == uid()
          && request.resource.data.pinnedAt is int
          && request.resource.data.pinnedAt >= now() - 60000
          && request.resource.data.pinnedAt <= now() + 60000
          && validEnvelope(request.resource.data.snapshot, 16384);

        // Write-once. Re-pinning is a no-op the client avoids; an update would
        // let a writer swap the snapshot under a pin the peer has already seen.
        allow update: if false;

        allow delete: if isPaired(roomId);
      }

      // --- doodles ---------------------------------------------------------
      //
      // Shared drawings over the chat, anchored to a message and expiring on the
      // same 24h schedule so a doodle lives as long as what it was drawn over.
      // The strokes are encrypted — a drawing is content — and write-once, like
      // images. Either paired device may erase one.

      match /doodles/{doodleId} {

        allow get: if isPaired(roomId) && notExpired(resource.data);
        allow list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && doodleId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'anchorId', 'createdAt', 'expiresAt', 'data'])
          && request.resource.data.owner == uid()
          && request.resource.data.anchorId is string
          && request.resource.data.anchorId.matches('^[A-Za-z0-9_-]{22,64}$')
          && validRetention(request.resource.data)
          && validEnvelope(request.resource.data.data, 120000);

        allow update: if false;
        allow delete: if isPaired(roomId);
      }

      // --- nicknames -------------------------------------------------------
      //
      // The one deliberate exception to nicknames being on-device only. A person
      // can publish the label THEY gave the other, so the other can see what
      // they are called. The document at nicknames/{slot} belongs to the slot in
      // its id — nicknames/a is A's label for B, nicknames/b is B's label for A —
      // and only that slot's holder may write it.
      //
      // Whether this is read back is a CLIENT choice, and that is where the app's
      // one-directional behaviour lives: the shipped client on the A side never
      // writes nicknames/a, so there is simply nothing in the database for B to
      // read. These rules stay symmetric (either side may write its own doc) so
      // they encode no assumption about which side is which; the direction is
      // policy, not schema.
      //
      // Encrypted, like all content — a plaintext label is exactly the kind of
      // readable index the rest of the app refuses to store. No expiry, like
      // emoji and pins.

      match /nicknames/{slot} {

        allow get, list: if isPaired(roomId) && (slot == 'a' || slot == 'b');

        allow create, update: if isPaired(roomId)
          && (slot == 'a' || slot == 'b')
          && ((slot == 'a' && isA(roomId)) || (slot == 'b' && isB(roomId)))
          && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= now() - 60000
          && request.resource.data.updatedAt <= now() + 60000
          && validEnvelope(request.resource.data.name, 256);

        allow delete: if isPaired(roomId)
          && ((slot == 'a' && isA(roomId)) || (slot == 'b' && isB(roomId)));
      }

      // --- call signalling -------------------------------------------------
      //
      // Short-lived WebRTC handshake state. The `offer` and `answer` fields
      // are encrypted envelopes, not raw SDP — SDP contains both parties' IP
      // addresses, so writing it in the clear (as most WebRTC tutorials do)
      // would tell the database where each person is and exactly when they
      // spoke. Encrypted, it reveals only that two paired devices exchanged
      // some ciphertext.
      //
      // Unlike messages, call documents are freely deletable: they are
      // ephemeral handshake residue, and leaving them lying around serves no
      // one. Both parties need to end a call, so delete is not restricted to
      // the caller.

      match /calls/{callId} {

        allow read: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && callId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['caller', 'kind', 'state', 'createdAt', 'expiresAt', 'offer'])
          && request.resource.data.caller in ['a', 'b']
          && request.resource.data.kind in ['audio', 'video']
          && request.resource.data.state == 'ringing'
          && request.resource.data.createdAt >= now() - 60000
          && request.resource.data.expiresAt == request.resource.data.createdAt + 3600000
          && validEnvelope(request.resource.data.offer, 32768);

        // Only `state` and `answer` may change. The offer is immutable once
        // written — swapping it mid-handshake would be a redirection attack.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'answer'])
          && request.resource.data.state in ['ringing', 'accepted', 'declined', 'ended']
          && (!('answer' in request.resource.data)
              || validEnvelope(request.resource.data.answer, 32768));

        allow delete: if isPaired(roomId);

        // ICE candidates, encrypted. Write-once and small.
        //
        // Two explicit matches rather than one `{side}Candidates` wildcard:
        // Firestore path segments cannot mix a wildcard with literal text, so
        // `{side}Candidates` is a syntax error rather than a pattern.
        match /callerCandidates/{candidateId} {
          allow read: if isPaired(roomId);
          allow create: if isPaired(roomId)
            && request.resource.data.keys().hasOnly(['data'])
            && validEnvelope(request.resource.data.data, 8192);
          allow update: if false;
          allow delete: if isPaired(roomId);
        }

        match /calleeCandidates/{candidateId} {
          allow read: if isPaired(roomId);
          allow create: if isPaired(roomId)
            && request.resource.data.keys().hasOnly(['data'])
            && validEnvelope(request.resource.data.data, 8192);
          allow update: if false;
          allow delete: if isPaired(roomId);
        }
      }

      // --- voice messages --------------------------------------------------
      //
      // Same shape and same constraints as images. Opus at 24 kbps capped at
      // 120 seconds lands around 350 KB, well inside the 1 MiB document limit;
      // the ceiling below is the hard backstop.

      match /audio/{audioId} {

        allow get: if isPaired(roomId) && notExpired(resource.data);
        allow list: if isPaired(roomId);

        allow create: if isPaired(roomId)
          && audioId.matches('^[A-Za-z0-9_-]{22,64}$')
          && request.resource.data.keys().hasOnly(
               ['owner', 'createdAt', 'expiresAt', 'data'])
          && request.resource.data.owner == uid()
          && validRetention(request.resource.data)
          && validEnvelope(request.resource.data.data, 1000000);

        // Only `expiresAt` may change, so the clip stays write-once. Lets a
        // pinned voice message outlive the sweep; see the images rule above for
        // the full reasoning.
        allow update: if isPaired(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
          && request.resource.data.expiresAt is int
          && (request.resource.data.expiresAt == pinKeepUntil()
              || request.resource.data.expiresAt <= now() + 86400000);

        allow delete: if isPaired(roomId) && resource.data.expiresAt <= now();
      }
    }

    // --- default deny ------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
